{
  "name": "morphiq-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --import tsx apps/runner/main.ts",
    "doctor": "node --import tsx scripts/cli.ts doctor",
    "status": "node --import tsx scripts/cli.ts status",
    "stop": "node --import tsx scripts/cli.ts stop",
    "export-run": "node --import tsx scripts/cli.ts export-run",
    "smoke": "node --import tsx scripts/smoke.ts",
    "import-mission": "node --import tsx scripts/import-mission.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests",
    "format": "prettier --write apps packages scripts tests config docs package.json tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test --config tests/playwright.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@anthropic-ai/sdk": "0.133.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
